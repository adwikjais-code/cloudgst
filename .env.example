# GST Cloud Bridge (server.js)
PORT=3000
NODE_ENV=production
API_SECRET=replace-with-strong-random-secret
ALLOW_NO_SECRET=false

# Strict comma-separated browser origins allowed by CORS
ALLOWED_ORIGIN=https://still-flower-aeed.taxandgstconsultancy.workers.dev,https://rough-sunset-e174.adwikjais.workers.dev,https://adwikjais-code.github.io,https://appassets.androidplatform.net

# Browser memory watchdog & session concurrency guardrails
MEM_LIMIT_MB=1200
MAX_SESSIONS=6
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Optional Android release keystore overrides (defaults to android/keystore.p12 in local repo)
# CLOUDGST_KEYSTORE_PATH=../keystore.p12
# CLOUDGST_KEYSTORE_PASS=
# CLOUDGST_KEY_ALIAS=
# CLOUDGST_KEY_PASS=
